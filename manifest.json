{
  "manifest_version": 3,
  "name": "Advence Transfer Analyzer",
  "description": "Dodaj do Sokker.org narzędzie do analizy transferów",
  "version": "2.1.0",

  "permissions": ["storage", "unlimitedStorage"],

  "host_permissions": [
    "https://sktables.org/*",       // Zmienione/Dodane: to jest właściwa domena blokowana przez CORS
    "https://www.sktables.org/*",   // Opcjonalnie: zostaw, jeśli jest potrzebne
    "https://sokker.org/*"
  ],

  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SQL Query",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://sokker.org/player/PID/*"],
      "js": ["helper/sqlQueryRunner.js","helper/extractDataFromPage.js", "similarTransfers.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sokker.org/transfers_player/ID_human/*"],
      "js": ["helper/sqlQueryRunner.js","helper/extractDataFromPage.js","skillHistory.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sokker.org/juniors/teamID/*"],
      "js": ["helper/sqlQueryRunner.js","helper/extractDataFromPage.js","juniorTable.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["sql-wasm.wasm"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}